<Window x:Class="TeronAddonManager.MarketplaceForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Browse ESOUI Addons"
        Width="900" Height="560"
        MinWidth="700" MinHeight="360"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="MarketplaceInstallButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="96"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Content" Value="Install"/>
            <Setter Property="Background" Value="#2EA05A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                    <Setter Property="Content" Value="Uninstall"/>
                    <Setter Property="Background" Value="#C24343"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Margin="12,12,12,8" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBox x:Name="searchTextBox" Width="180" Height="30" VerticalContentAlignment="Center"/>
                    <TextBlock Text="Search" IsHitTestVisible="False" VerticalAlignment="Center" Margin="10,0,0,0" Opacity="0.5">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Text, ElementName=searchTextBox}" Value=""/>
                                            <Condition Binding="{Binding IsFocused, ElementName=searchTextBox}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <TextBlock Grid.Column="1" Text="Category:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox Grid.Column="2" x:Name="categoryComboBox" Height="30" Width="160" Margin="0,0,16,0"/>
                <TextBlock Grid.Column="3" Text="Sort by:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox Grid.Column="4" x:Name="sortComboBox" Height="30" Width="140"/>
                <Button Grid.Column="6" x:Name="refreshButton" Style="{StaticResource ToolbarIconButtonStyle}" ToolTip="Refresh Catalog">
                    <TextBlock Text="&#xE895;"/>
                </Button>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="12,0,12,8" Padding="4">
            <ListView x:Name="resultsListView" SelectionMode="Extended">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Title" Width="220" DisplayMemberBinding="{Binding Title}"/>
                        <GridViewColumn Header="Author" Width="140" DisplayMemberBinding="{Binding Author}"/>
                        <GridViewColumn Header="Category" Width="150" DisplayMemberBinding="{Binding CategoryTitle}"/>
                        <GridViewColumn Header="Downloads" Width="90" DisplayMemberBinding="{Binding DownloadsText}"/>
                        <GridViewColumn Header="Last Updated" Width="100" DisplayMemberBinding="{Binding LastUpdatedText}"/>
                        <GridViewColumn Header="" Width="116">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource MarketplaceInstallButtonStyle}" Click="InstallRowButton_Click"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
                <ListView.ContextMenu>
                    <ContextMenu>
                        <MenuItem x:Name="viewDetailsContextItem" Header="View Details..."/>
                    </ContextMenu>
                </ListView.ContextMenu>
            </ListView>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="12,0,12,8">
            <Button x:Name="closeButton" Content="Close" Width="90" Height="32" IsCancel="True"/>
        </StackPanel>

        <Border Grid.Row="3" BorderThickness="0,1,0,0" BorderBrush="{StaticResource DividerBrush}" Padding="12,6">
            <TextBlock x:Name="statusText" Text="Loading..."/>
        </Border>
    </Grid>
</Window>
