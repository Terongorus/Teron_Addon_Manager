<Window x:Class="TeronAddonManager.FluentMessageBoxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="24,24,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Top">
            <Border x:Name="accentBar" Width="4" Margin="0,0,16,0" CornerRadius="2"
                    VerticalAlignment="Stretch"/>
            <TextBlock x:Name="messageText" TextWrapping="Wrap" MaxWidth="320"
                       VerticalAlignment="Center" FontSize="14"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button x:Name="negativeButton" Content="Cancel" Width="90" Height="32" Margin="0,0,8,0" IsCancel="True" Visibility="Collapsed"/>
            <Button x:Name="affirmativeButton" Content="OK" Width="90" Height="32" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
