<Window x:Class="Teron_Addon_Manager.Addon_Manager"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Teron_Addon_Manager"
        Title="Teron Addon Manager"
        Width="900" Height="560"
        MinWidth="640" MinHeight="360">
    <Window.Resources>
        <local:StatusColorConverter x:Key="StatusColorConverter"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" Margin="12,12,12,8">
            <Button x:Name="checkUpdatesButton" Content="Check for Updates" Height="32" Padding="12,0" Margin="0,0,6,6"/>
            <Button x:Name="updateSelectedButton" Content="Update Selected" Height="32" Padding="12,0" Margin="0,0,6,6"/>
            <Button x:Name="removeSelectedButton" Content="Remove Selected" Height="32" Padding="12,0" Margin="0,0,16,6"/>
            <Button x:Name="addAddonButton" Content="Manual Add Addon..." Height="32" Padding="12,0" Margin="0,0,6,6"/>
            <Button x:Name="scanLocalButton" Content="Scan for Local Addons..." Height="32" Padding="12,0" Margin="0,0,6,6"/>
            <Button x:Name="browseMarketplaceButton" Content="Browse Addons..." Height="32" Padding="12,0" Margin="0,0,6,6"/>
            <Button x:Name="openFolderButton" Content="Open AddOns Folder" Height="32" Padding="12,0" Margin="0,0,0,6"/>
        </WrapPanel>

        <Grid Grid.Row="1" Margin="12,0,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock DockPanel.Dock="Top" Text="Game Version" FontWeight="Bold" Margin="0,0,0,6"/>
                <ListBox x:Name="targetListBox"/>
            </DockPanel>

            <ListView Grid.Column="1" x:Name="addonListView" SelectionMode="Extended">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Name" Width="220" DisplayMemberBinding="{Binding Name}"/>
                        <GridViewColumn Header="Installed" Width="100" DisplayMemberBinding="{Binding Installed}"/>
                        <GridViewColumn Header="Latest" Width="100" DisplayMemberBinding="{Binding Latest}"/>
                        <GridViewColumn Header="Status" Width="120">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding Status, Converter={StaticResource StatusColorConverter}}" Padding="6,3" Margin="-6,0">
                                        <TextBlock Text="{Binding Status}"/>
                                    </Border>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Source" Width="100" DisplayMemberBinding="{Binding Source}"/>
                    </GridView>
                </ListView.View>
                <ListView.ContextMenu>
                    <ContextMenu>
                        <MenuItem x:Name="viewDetailsContextItem" Header="View Details..."/>
                        <MenuItem x:Name="checkSelectedContextItem" Header="Check for Updates"/>
                        <MenuItem x:Name="updateSelectedContextItem" Header="Update"/>
                        <MenuItem x:Name="removeSelectedContextItem" Header="Remove"/>
                    </ContextMenu>
                </ListView.ContextMenu>
            </ListView>
        </Grid>

        <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="#33808080" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="statusLabel" Text="Ready." VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="Theme:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="themeComboBox" Width="100"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
