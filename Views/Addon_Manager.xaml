<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Teron_Addon_Manager.Helpers"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" x:Class="Teron_Addon_Manager.Addon_Manager"
        Title="Teron Addon Manager"
        Width="900" Height="560"
        MinWidth="640" MinHeight="360">
    <Window.Resources>
        <local:StatusColorConverter x:Key="StatusColorConverter"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Margin="12,12,12,8" Padding="6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,4,0">
                    <TextBlock Text="Theme" VerticalAlignment="Center" Opacity="0.7"/>
                    <Border Style="{StaticResource SegmentedControlBorderStyle}" Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="themeSystemRadio" Content="System" GroupName="ThemeMode" Style="{StaticResource SegmentedToggleButtonStyle}"/>
                            <RadioButton x:Name="themeLightRadio" Content="Light" GroupName="ThemeMode" Style="{StaticResource SegmentedToggleButtonStyle}"/>
                            <RadioButton x:Name="themeDarkRadio" Content="Dark" GroupName="ThemeMode" Style="{StaticResource SegmentedToggleButtonStyle}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <WrapPanel DockPanel.Dock="Left">
                    <Button x:Name="addAddonButton" Style="{StaticResource ToolbarIconButtonStyle}" ToolTip="Manual Add Addon...">
                        <TextBlock Text="&#xE710;"/>
                    </Button>
                    <Button x:Name="scanLocalButton" Style="{StaticResource ToolbarIconButtonStyle}" ToolTip="Scan for Local Addons...">
                        <TextBlock Text="&#xE721;"/>
                    </Button>
                    <Button x:Name="browseMarketplaceButton" Style="{StaticResource ToolbarIconButtonStyle}" ToolTip="Browse Addons...">
                        <TextBlock Text="&#xE774;"/>
                    </Button>
                    <Border Style="{StaticResource ToolbarDividerStyle}"/>
                    <Button x:Name="checkUpdatesButton" Style="{StaticResource ToolbarIconButtonStyle}" ToolTip="Check for Updates">
                        <TextBlock Text="&#xE895;"/>
                    </Button>
                    <Button x:Name="updateSelectedButton" Style="{StaticResource ToolbarIconButtonStyle}" ToolTip="Update Selected" IsEnabled="False">
                        <TextBlock Text="&#xE896;"/>
                    </Button>
                    <Button x:Name="removeSelectedButton" Style="{StaticResource ToolbarIconButtonStyle}" ToolTip="Remove Selected" IsEnabled="False">
                        <TextBlock Text="&#xE74D;"/>
                    </Button>
                    <Border Style="{StaticResource ToolbarDividerStyle}"/>
                    <Button x:Name="openFolderButton" Style="{StaticResource ToolbarIconButtonStyle}" ToolTip="Open AddOns Folder">
                        <TextBlock Text="&#xE8B7;"/>
                    </Button>
                </WrapPanel>
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBox x:Name="searchTextBox" Width="240" Height="34" VerticalContentAlignment="Center"/>
                    <TextBlock Text="Search" IsHitTestVisible="False" VerticalAlignment="Center" Margin="10,0,0,0" Opacity="0.5">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Text, ElementName=searchTextBox}" Value=""/>
                                            <Condition Binding="{Binding IsFocused, ElementName=searchTextBox}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="12,0,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,8,0" Padding="10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Game Version" FontWeight="Bold" Margin="0,0,0,6"/>
                    <ListBox x:Name="targetListBox">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="6" Padding="8,6" Margin="0,1"
                                        Background="{Binding IsCurrent, Converter={StaticResource SelectedHighlightConverter}}">
                                    <TextBlock Text="{Binding DisplayName}"
                                               Foreground="{Binding IsCurrent, Converter={StaticResource SelectedForegroundConverter}}"/>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="4">
                <ListView x:Name="addonListView" SelectionMode="Extended">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn x:Name="nameColumn" Width="220">
                                <GridViewColumn.Header>
                                    <DockPanel LastChildFill="False">
                                        <TextBlock DockPanel.Dock="Left" Text="Name" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="nameSortArrow" DockPanel.Dock="Right" VerticalAlignment="Center"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"/>
                                    </DockPanel>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" Margin="10,0"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn x:Name="installedColumn" Width="100">
                                <GridViewColumn.Header>
                                    <DockPanel LastChildFill="False">
                                        <TextBlock DockPanel.Dock="Left" Text="Installed" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="installedSortArrow" DockPanel.Dock="Right" VerticalAlignment="Center"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"/>
                                    </DockPanel>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Installed}" Margin="10,0"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn x:Name="latestColumn" Width="100">
                                <GridViewColumn.Header>
                                    <DockPanel LastChildFill="False">
                                        <TextBlock DockPanel.Dock="Left" Text="Latest" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="latestSortArrow" DockPanel.Dock="Right" VerticalAlignment="Center"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"/>
                                    </DockPanel>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Latest}" Margin="10,0"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn x:Name="statusColumn" Width="120">
                                <GridViewColumn.Header>
                                    <DockPanel LastChildFill="False">
                                        <TextBlock DockPanel.Dock="Left" Text="Status" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="statusSortArrow" DockPanel.Dock="Right" VerticalAlignment="Center"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"/>
                                    </DockPanel>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource StatusBadgeStyle}" Background="{Binding Status, Converter={StaticResource StatusColorConverter}}">
                                            <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="SemiBold"/>
                                        </Border>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn x:Name="sourceColumn" Width="100">
                                <GridViewColumn.Header>
                                    <DockPanel LastChildFill="False">
                                        <TextBlock DockPanel.Dock="Left" Text="Source" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="sourceSortArrow" DockPanel.Dock="Right" VerticalAlignment="Center"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"/>
                                    </DockPanel>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Source}" Margin="10,0"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                    <ListView.ContextMenu>
                        <ContextMenu>
                            <MenuItem x:Name="viewDetailsContextItem" Header="View Details..."/>
                            <MenuItem x:Name="checkSelectedContextItem" Header="Check for Updates"/>
                            <MenuItem x:Name="updateSelectedContextItem" Header="Update"/>
                            <MenuItem x:Name="removeSelectedContextItem" Header="Remove"/>
                        </ContextMenu>
                    </ListView.ContextMenu>
                </ListView>
            </Border>
        </Grid>

        <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{StaticResource DividerBrush}" Padding="12,6">
            <TextBlock x:Name="statusLabel" Text="Ready." VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>