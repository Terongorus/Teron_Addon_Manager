<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>2.5.0</Version>
    <RootNamespace>TeronAddonManager</RootNamespace>
    <AssemblyName>TeronAddonManager</AssemblyName>
    <AssemblyTitle>TeronAddonManager</AssemblyTitle>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <!-- WPF0001: ThemeMode runtime switching (Light/Dark/System toggle) is still an experimental API. -->
    <NoWarn>$(NoWarn);WPF0001;</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Resources\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <Page Include="App.xaml" />
  </ItemGroup>

</Project>