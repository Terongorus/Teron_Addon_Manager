<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>TeronAddonManager</RootNamespace>
    <AssemblyName>TeronAddonManager</AssemblyName>
    <AssemblyTitle>TeronAddonManager</AssemblyTitle>
    <!-- Without this, the SDK appends "+<git-commit-sha>" to AssemblyInformationalVersion
         (read for the main window title), since Deterministic builds in a git repo include
         source revision info there by default. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <Product>Teron Addon Manager (TAM)</Product>
    <Company>Teronverse</Company>
    <!-- WPF0001: ThemeMode runtime switching (Light/Dark/System toggle) is still an experimental API. -->
    <NoWarn>$(NoWarn);WPF0001;</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup>
    <MajorMinorPatchVersion>2.8.1</MajorMinorPatchVersion>
    <BuildNumberFile>$(MSBuildProjectDirectory)\BuildNumber.txt</BuildNumberFile>
  </PropertyGroup>

  <Target Name="IncrementBuildNumber" BeforeTargets="BeforeBuild">
    <ReadLinesFromFile File="$(BuildNumberFile)" Condition="Exists('$(BuildNumberFile)')">
      <Output TaskParameter="Lines" ItemName="_BuildNumberLine" />
    </ReadLinesFromFile>
    <PropertyGroup>
      <_PreviousBuildNumber Condition="'@(_BuildNumberLine)' != ''">@(_BuildNumberLine)</_PreviousBuildNumber>
      <_PreviousBuildNumber Condition="'$(_PreviousBuildNumber)' == ''">0</_PreviousBuildNumber>
      <BuildNumber>$([MSBuild]::Add($(_PreviousBuildNumber), 1))</BuildNumber>
    </PropertyGroup>
    <WriteLinesToFile File="$(BuildNumberFile)" Lines="$(BuildNumber)" Overwrite="true" />
    <PropertyGroup>
      <AssemblyVersion>$(MajorMinorPatchVersion).$(BuildNumber)</AssemblyVersion>
      <FileVersion>$(MajorMinorPatchVersion).$(BuildNumber)</FileVersion>
      <Version>$(MajorMinorPatchVersion).$(BuildNumber)</Version>
    </PropertyGroup>
  </Target>

  <ItemGroup>
    <Content Include="Resources\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <Page Include="App.xaml" />
  </ItemGroup>

  <!--
    Builds the Inno Setup installer right after `dotnet publish`/VS Publish finishes writing
    the self-contained output, so publishing the win-x64 or win-x86 profile produces a ready-to-
    distribute "TeronAddonManagerSetup-<arch>.exe" in bin\InstallerPackage with no extra steps.
    No-ops (with a warning) if Inno Setup isn't installed, so it never breaks a plain publish/build.

    Everything here is computed inside the target body, evaluated when the target actually runs,
    rather than in a top-level PropertyGroup: publish-profile properties like RuntimeIdentifier
    and SelfContained aren't populated yet during the project's normal (early) static evaluation
    of top-level PropertyGroups - only once the publish pipeline itself is running.
  -->
  <Target Name="BuildInnoSetupInstaller" AfterTargets="Publish">
    <PropertyGroup>
      <InnoSetupArch Condition="'$(RuntimeIdentifier)' == 'win-x64'">x64</InnoSetupArch>
      <InnoSetupArch Condition="'$(RuntimeIdentifier)' == 'win-x86'">x86</InnoSetupArch>

      <InnoSetupCompiler Condition="'$(InnoSetupCompiler)' == '' AND Exists('$(LocalAppData)\Programs\Inno Setup 6\ISCC.exe')">$(LocalAppData)\Programs\Inno Setup 6\ISCC.exe</InnoSetupCompiler>
      <InnoSetupCompiler Condition="'$(InnoSetupCompiler)' == '' AND Exists('$(MSBuildProgramFiles32)\Inno Setup 6\ISCC.exe')">$(MSBuildProgramFiles32)\Inno Setup 6\ISCC.exe</InnoSetupCompiler>
      <InnoSetupCompiler Condition="'$(InnoSetupCompiler)' == '' AND Exists('$(ProgramFiles)\Inno Setup 6\ISCC.exe')">$(ProgramFiles)\Inno Setup 6\ISCC.exe</InnoSetupCompiler>
    </PropertyGroup>

    <Exec Command="&quot;$(InnoSetupCompiler)&quot; /DArch=$(InnoSetupArch) /DMyAppVersion=$(FileVersion) &quot;$(MSBuildProjectDirectory)\Installer\TeronAddonManager.iss&quot;"
          Condition="'$(InnoSetupArch)' != '' AND '$(SelfContained)' == 'true' AND '$(InnoSetupCompiler)' != ''" />
    <Warning Text="Inno Setup (ISCC.exe) was not found in the usual install locations; skipping installer build. Install it with 'winget install JRSoftware.InnoSetup' to enable this step."
              Condition="'$(InnoSetupArch)' != '' AND '$(SelfContained)' == 'true' AND '$(InnoSetupCompiler)' == ''" />
  </Target>

</Project>